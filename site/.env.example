# Copy this file to .env for local development. .env is git-ignored.
# Production configuration lives on the server (see BUILD.md, milestone W5).

# PostgreSQL connection string. Matches the database in compose.yaml.
DATABASE_URL="postgres://cftgu:cftgu@127.0.0.1:5434/cfromthegroundup"

# Host port for the compose.yaml database (default 5434). Change it here and
# in DATABASE_URL if 5434 is taken.
# DB_PORT=5434

# `npm run start` (node build) only: the URL the server is reached at.
# Production sets it in the systemd unit.
# ORIGIN=http://127.0.0.1:3000

# Accounts (GitHub sign-in, milestone W6) are off unless all four are set.
# Create a GitHub OAuth app with the callback URL <origin>/api/auth/callback/github.
# BETTER_AUTH_SECRET=   # openssl rand -hex 32
# BETTER_AUTH_URL=http://127.0.0.1:5173
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
