# Copy this file to .env for local development. .env is git-ignored.
# Production configuration lives on the server (see BUILD.md, milestone W5).

# PostgreSQL 18 connection string for the app (and the e2e test helpers).
# On the server, use the test database on the host cluster, whose
# credentials are in ~/.config/cfromthegroundup/test.env (site/deploy/README.md,
# "Test database"). Elsewhere, any local PostgreSQL 18 database you own.
DATABASE_URL="postgres://USER:PASSWORD@127.0.0.1:5432/cfromthegroundup_test"

# Only when the database has the host's owner / web / migration roles: the
# migration role for `pnpm run db:migrate` and the e2e migrator step, and the
# owner it switches to. Without them the migrator uses DATABASE_URL.
# MIGRATION_DATABASE_URL="postgres://USER:PASSWORD@127.0.0.1:5432/cfromthegroundup_test"
# DB_OWNER_ROLE=cfromthegroundup_test_owner

# `pnpm run start` (node build) only: the URL the server is reached at.
# Production sets it in the systemd unit.
# ORIGIN=http://127.0.0.1:3000

# Accounts (GitHub sign-in, milestone W6) are off unless all four are set.
# Create a GitHub OAuth app with the callback URL <origin>/api/auth/callback/github.
# BETTER_AUTH_SECRET=   # openssl rand -hex 32
# BETTER_AUTH_URL=http://127.0.0.1:5173
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
