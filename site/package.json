{
	"name": "cfromthegroundup-site",
	"version": "0.0.1",
	"description": "cfromthegroundup.com: the course website for C From The Ground Up",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "26.13.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-migrator.ts",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource/inter": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@playwright/test": "1.65.1",
		"@resvg/resvg-wasm": "2.6.2",
		"@sveltejs/adapter-node": "6.0.5",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.5",
		"@types/hast": "3.0.5",
		"@types/mdast": "4.0.4",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@vitest/browser-playwright": "5.1.1",
		"better-auth": "1.7.27",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"fflate": "0.8.3",
		"globals": "17.14.0",
		"hast-util-to-html": "9.0.7",
		"hast-util-to-string": "3.0.1",
		"minisearch": "7.2.0",
		"pg": "8.23.1",
		"playwright": "1.65.1",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"rehype-autolink-headings": "7.1.0",
		"rehype-slug": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"rolldown": "1.2.19",
		"satori": "0.63.2",
		"shiki": "4.6.0",
		"svelte": "5.58.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"unified": "11.0.5",
		"valibot": "1.5.0",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"vitest-browser-svelte": "3.1.0"
	},
	"packageManager": "pnpm@12.18.0"
}
